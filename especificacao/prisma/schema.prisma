// Reajusta — modelo físico (Prisma na última versão estável, PostgreSQL; validado com Prisma 6.x em 31/10/2026)
// Descrição, regras de integridade e SQL complementar (gatilhos, CHECK, REVOKE): especificacao/06_MODELO_DADOS.md.
// Nomes do glossário de 01_VISAO_ESCOPO.md §7, em português e sem acento.
// Entidades marcadas "(proposto)" não estão na seção 11 do documento-base e precisam ser acrescentadas lá.
// Convenções: id uuid; tabelas em snake_case (@@map); colunas em camelCase; mês "AAAA-MM" em Char(7);
// percentuais em pontos percentuais (6,30 = 6,30%); data civil em @db.Date.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

