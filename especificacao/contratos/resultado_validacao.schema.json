{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agenersa/resultado_validacao/0.1",
  "title": "Resultado da validação de um pleito de reajuste (regras V01 a V12)",
  "description": "Rascunho 0.1. Produzido pelo sistema na validação prévia (modo 'previa', sem registro) e na validação registrada do pleito enviado (modo 'registrada'). Guarda as versões do layout, do cadastro, das regras e das séries usadas (RNF-03). Cada item tem regra, situação e mensagem, como o oráculo scripts/validar_pleito.py; os demais campos são estruturados para tela e auditoria. Números em pontos percentuais com ponto decimal; datas ISO 8601.",
  "type": "object",
  "required": ["modo", "executado_em", "versao_layout", "versao_regras", "contrato", "decisao", "resumo", "itens"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "format": "uuid", "description": "Ausente no modo 'previa'"},
    "modo": {"enum": ["previa", "registrada"]},
    "pleito_id": {"type": "string", "format": "uuid", "description": "Obrigatório no modo 'registrada'"},
    "ciclo_id": {"type": "string", "format": "uuid"},
    "processo_sei": {"type": ["string", "null"], "description": "Número do processo SEI do ciclo, ex.: 'SEI-480002/009982/2025'"},
    "substitui": {"type": ["string", "null"], "format": "uuid", "description": "Resultado anterior do mesmo pleito, na revalidação após 'a refazer'"},
    "executado_em": {"type": "string", "format": "date-time"},
    "duracao_ms": {"type": "integer", "minimum": 0},
    "versao_layout": {"type": "string", "description": "Versão do layout do pleito, ex.: '0.1'"},
    "versao_regras": {"type": "string", "description": "Versão do conjunto de regras V01 a V12 aplicado, ex.: '1.0.0'"},
    "sha256_pleito": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "Hash do pleito.json avaliado"},
    "contrato": {
      "type": "object", "required": ["numero", "versao_contratual"], "additionalProperties": false,
      "properties": {
        "numero": {"type": "string"},
        "versao_contratual": {"type": "string"},
        "versao_cadastro": {"type": ["string", "null"], "description": "Identificador da revisão do cadastro usada (hash ou número da revisão)"}
      }
    },
    "series_usadas": {
      "type": "array",
      "items": {
        "type": "object", "required": ["fonte", "codigo", "consultada_em", "origem"], "additionalProperties": false,
        "properties": {
          "fonte": {"type": "string", "description": "Ex.: 'IPEADATA', 'IBGE SIDRA', 'ANEEL'"},
          "codigo": {"type": "string", "description": "Ex.: 'IGP12_IPC12', '3065'"},
          "consultada_em": {"type": "string", "format": "date-time"},
          "origem": {"enum": ["api", "cache"]}
        }
      }
    },
    "decisao": {"enum": ["devolver", "segue_para_analise", "a_refazer"], "description": "RN-VAL-00: erro → devolver; sem erro e algum item a refazer → a_refazer; senão segue_para_analise"},
    "resumo": {
      "type": "object", "required": ["ok", "aviso", "erro"], "additionalProperties": false,
      "properties": {
        "ok": {"type": "integer", "minimum": 0},
        "aviso": {"type": "integer", "minimum": 0},
        "erro": {"type": "integer", "minimum": 0},
        "a_refazer": {"type": "integer", "minimum": 0}
      }
    },
    "itens": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/item"}},
    "apuracao": {"$ref": "#/$defs/apuracao_resumo"}
  },
  "allOf": [
    {"if": {"properties": {"modo": {"const": "registrada"}}}, "then": {"required": ["id", "pleito_id", "ciclo_id"]}}
  ],
  "$defs": {
    "item": {
      "type": "object",
      "required": ["regra", "situacao", "mensagem"],
      "additionalProperties": false,
      "properties": {
        "regra": {"type": "string", "pattern": "^V(0[1-9]|1[0-2])$"},
        "situacao": {"enum": ["ok", "aviso", "erro"]},
        "mensagem": {"type": "string", "minLength": 1, "description": "Frase para quem analisa, números no formato brasileiro (RNF-09)"},
        "codigo": {"type": "string", "description": "Código estável da ocorrência, ex.: 'V07_ARREDONDADO', 'V11_SEM_COMPOSICAO'"},
        "a_refazer": {"type": "boolean", "default": false, "description": "Fonte externa indisponível; conferência a refazer (RN-SER-04)"},
        "componente": {"type": ["string", "null"], "description": "Sigla do componente, quando a ocorrência é de um componente"},
        "caminho": {"type": ["string", "null"], "description": "JSON Pointer do campo do pleito (V01)"},
        "valores": {"type": "object", "description": "Números brutos da ocorrência, ex.: {\"ir_recalculado\": 3.9669, \"ir_arredondado\": 3.967, \"ir_declarado\": 3.967}", "additionalProperties": {"type": ["number", "string", "boolean", "null", "array"]}},
        "origem": {"type": "array", "items": {"type": "string"}, "description": "Referências da origem de cada número: campo do pleito, série com data da consulta, trecho do cadastro (RNF-02)"}
      }
    },
    "termo": {
      "type": "object", "required": ["sigla", "peso", "indice_o", "indice_i", "variacao_pct", "ponderado_pp"], "additionalProperties": false,
      "properties": {
        "sigla": {"type": "string"},
        "peso": {"type": ["number", "null"]},
        "indice_o": {"type": "number"},
        "indice_i": {"type": "number"},
        "variacao_pct": {"type": "number"},
        "ponderado_pp": {"type": "number"}
      }
    },
    "apuracao_resumo": {
      "type": "object",
      "required": ["mes_o", "mes_i", "ir_recalculado_pct", "ir_arredondado_pct", "combinacao", "total_recalculado_pct"],
      "additionalProperties": false,
      "properties": {
        "apuracao_id": {"type": "string", "format": "uuid"},
        "mes_o": {"type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"},
        "mes_i": {"type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"},
        "termos": {"type": "array", "items": {"$ref": "#/$defs/termo"}},
        "soma_pesos": {"type": ["number", "null"]},
        "ir_recalculado_pct": {"type": "number"},
        "ir_arredondado_pct": {"type": "number"},
        "casas_decimais_ir": {"type": "integer"},
        "combinacao": {"enum": ["multiplicativa", "aditiva"]},
        "parcela_realinhamento": {
          "type": ["object", "null"], "additionalProperties": false,
          "properties": {"parcela": {"type": "integer"}, "referencia": {"type": "string"}, "pct": {"type": "number"}}
        },
        "total_recalculado_pct": {"type": "number"},
        "intersticio": {
          "type": "object", "additionalProperties": false,
          "properties": {"meses_referencia": {"type": "integer"}, "dias": {"type": "integer"}}
        }
      }
    }
  }
}
